IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASS=change-me
# IMAP_SECURE=true

SMTP_HOST=mail.example.com
SMTP_PORT=465
# SMTP_USER and SMTP_PASS default to the IMAP ones
# SMTP_USER=you@example.com
# SMTP_PASS=change-me
# SMTP_FROM="You <you@example.com>"
# SMTP_SECURE=true

# Several mailboxes: list them, then prefix every var with the upper-cased name.
# Without MAIL_ACCOUNTS, the unprefixed IMAP_*/SMTP_* vars above define one account.
# MAIL_ACCOUNTS=perso,pro
# MAIL_DEFAULT_ACCOUNT=perso
# PERSO_IMAP_HOST=mail.example.com
# PERSO_IMAP_USER=me@example.com
# PERSO_IMAP_PASS=change-me
# PERSO_SMTP_HOST=mail.example.com
# PRO_IMAP_HOST=mail.other.com
# PRO_IMAP_USER=me@other.com
# PRO_IMAP_PASS=change-me
# PRO_SMTP_HOST=mail.other.com

# Admin UI to add mailboxes from a browser (needs MCP_TRANSPORT=http).
# Setting MAILMCP_DATA_DIR enables it. It listens on 127.0.0.1:ADMIN_PORT only (use an SSH tunnel).
# Public access (/admin on the MCP domain) can be enabled from the admin once TOTP is configured.
# Persistent folder OUTSIDE the Mas releases (a redeploy wipes the release folder). Holds accounts.enc.json.
# MAILMCP_DATA_DIR=/var/lib/mailmcp
# ADMIN_PORT=3001
# ADMIN_ACCESS=off            # disables the admin even with MAILMCP_DATA_DIR
# Encryption key of the accounts file. Defaults to MCP_AUTH_TOKEN: if you rotate the token, set this first.
# MAILMCP_ENCRYPTION_KEY=
# Optional: fix the authenticator secret here instead of the UI. Generate with: node dist/totp-secret.js
# ADMIN_TOTP_SECRET=
# Lost your authenticator? Set to true for one start, then remove.
# ADMIN_RESET_TOTP=true

# Set to false only for self-signed certificates (applies to all accounts)
# MAIL_TLS_REJECT_UNAUTHORIZED=true

# Transport: stdio (default, Claude Desktop local) or http (Mas deployment)
MCP_TRANSPORT=http
# http only. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-at-least-16-chars
# Local only. On Mas, do NOT set HOST/PORT: Mas injects them in the systemd unit.
# HOST=127.0.0.1
# PORT=3000
