IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASS=change-me
# IMAP_SECURE=true

SMTP_HOST=mail.example.com
SMTP_PORT=465
# SMTP_USER and SMTP_PASS default to the IMAP ones
# SMTP_USER=you@example.com
# SMTP_PASS=change-me
# SMTP_FROM="You <you@example.com>"
# SMTP_SECURE=true

# Set to false only for self-signed certificates
# MAIL_TLS_REJECT_UNAUTHORIZED=true

# Transport: stdio (default, Claude Desktop local) or http (Mas deployment)
MCP_TRANSPORT=http
# http only. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-at-least-16-chars
# Local only. On Mas, do NOT set HOST/PORT: Mas injects them in the systemd unit.
# HOST=127.0.0.1
# PORT=3000
